# En desarrollo puedes dejar la base vacía: Vite hace proxy de /api → backend.
# VITE_API_BASE_URL=

# Si no usas proxy, apunta directo al Nest:
# VITE_API_BASE_URL=http://127.0.0.1:3000

VITE_PUBLIC_ANNOUNCEMENTS_PATH=/api/public/comunicados

# Transparencia — rutas relativas a la base (proxy Vite en desarrollo).
# VITE_PUBLIC_TRANSPARENCIA_PATH=/api/public/transparencia
# VITE_ADMIN_TRANSPARENCIA_PATH=/api/admin/transparencia

# Ruta pública de la galería relativa a la base.
# VITE_PUBLIC_GALLERY_PATH=/api/public/galeria
# VITE_ADMIN_GALLERY_PATH=/api/admin/galeria
