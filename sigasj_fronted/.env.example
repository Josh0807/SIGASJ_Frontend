# API Backend (Vite)
# Desarrollo local. Vite hace proxy de /api y /uploads hacia este origen.
VITE_API_URL=http://localhost:3000/api/v1

# Producción en Vercel: defina VITE_API_URL en el proyecto (Environment Variables)
# con la URL HTTPS de la API publicada en Render. El build la rechaza si falta o no es HTTPS.
# Sirve el origen o la base completa; el cliente normaliza a /api/v1.
# VITE_API_URL=https://<servicio>.onrender.com/api/v1
# Opcional, solo si fotos y documentos se sirven en otro origen:
# VITE_BACKEND_URL=https://<servicio>.onrender.com

# Jotform — solo el Form ID público para el embed del Fontanero (PBI 6.5.5).
# Formulario: https://form.jotform.com/262915442146861
# NO coloque JOTFORM_API_KEY ni JOTFORM_WEBHOOK_SECRET aquí: son exclusivos del Backend.
VITE_JOTFORM_FORM_ID=262915442146861
